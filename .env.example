# SYNORA environment variables.
# Copy this file to `backend/.env` (the only file the stack needs) and adjust:
#   copy .env.example backend/.env
# NEVER commit `backend/.env` — it is gitignored.
# The frontend reads only API_URL, set inside docker-compose.yml (or your shell).

APP_NAME=SYNORA API
APP_ENV=dev                                    # dev | test | prod
DEBUG=true                                     # expose tracebacks only when true

# --- Database --------------------------------------------------------------
# NOTE: docker-compose overrides this with a URL pointing at the `postgres`
# container. This value is for LOCAL (non-Docker) development.
DATABASE_URL=postgresql+asyncpg://synora:synora@localhost:55432/synora
POSTGRES_USER=synora
POSTGRES_PASSWORD=synora
POSTGRES_DB=synora
POSTGRES_PORT=55432                            # host-side port (container is 5432)

# --- Ports -----------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend --------------------------------------------------------------
# Only needed when running the Next.js dev server OUTSIDE Docker. Compose sets
# this to http://backend:8000 (the Docker network name) automatically.
API_URL=http://localhost:8000

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<generate-a-random-64-char-urlsafe-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Rate limiting ---------------------------------------------------------
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900           # 15 min
LOGIN_LOCKOUT_SECONDS=900

REFRESH_COOKIE_SECURE=true                        # set false for local http dev

# --- CORS ------------------------------------------------------------------
# Comma-separated origins. No wildcard in anything resembling production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Uploads ---------------------------------------------------------------
# Local disk in dev. NOTE: swap for S3-compatible object storage before
# production.
UPLOAD_DIR=uploads