# SYNORA PRODUCTION environment template.
#
# Copy to `.env.prod` on the VM, fill every secret, then deploy:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Keep `.env.prod` OFF the repo and out of git history.

# --- Public host ------------------------------------------------------------
# A record must point at this VM BEFORE the first `up` so Caddy can issue the
# Let's Encrypt certificate.
DOMAIN=synora.example.com
PUBLIC_APP_URL=https://synora.example.com

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=synora
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=synora

# --- Backend secrets --------------------------------------------------------
# 64-char urlsafe random: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_64_CHAR_GENERATED
# Comma-separated http(s) origins your frontend is served from (no wildcard):
CORS_ORIGINS=https://synora.example.com

# --- Payme (live) -----------------------------------------------------------
# Set to the LIVE merchant credentials after your sandbox demo passes.
PAYME_CHECKOUT_BASE_URL=https://checkout.paycom.uz
PAYME_LOGIN=Paycom
PAYME_KEY=CHANGE_ME_LIVE_KEY
PAYME_MERCHANT_ID=CHANGE_ME_CASHIER_ID
PAYME_IS_TEST=false

# --- MinIO / object storage -------------------------------------------------
# Defaults match the compose file; override if you bring your own S3 endpoint.
MINIO_ROOT_USER=synora
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=synora-uploads

# --- Backups ----------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400     # every 24 h
BACKUP_RETENTION_DAYS=14

# --- Waiter kiosk PIN login --------------------------------------------------
# This server is multi-tenant, so the waiter kiosk's unauthenticated "pick a
# name, enter a PIN" endpoints stay empty until scoped to ONE restaurant here.
# Find the slug: GET /api/v1/restaurant/me while logged in as the owner.
WAITER_RESTAURANT_SLUG=

# --- Waiter PWA branding (this client's install-to-home-screen app) --------
# Leave unset to keep the default "SYNORA Ofitsiant" branding. To rebrand for
# a client, also run: node scripts/gen-waiter-icons.mjs <path-to-logo.svg>
#WAITER_APP_NAME=Osh Markazi Ofitsiant
#WAITER_APP_SHORT_NAME=Osh Markazi
#WAITER_APP_THEME_COLOR=#5b46e8