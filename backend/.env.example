# SYNORA backend environment variables.
# Copy to `.env` and adjust. NEVER commit `.env` — it is gitignored.
# For production, keep secrets in a secrets manager (AWS Secrets Manager,
# Vault, etc.), NOT in a committed .env file. This file only documents the
# expected variables for local dev.

APP_NAME=SYNORA API
APP_ENV=dev                                    # dev | test | prod
DEBUG=true                                     # expose tracebacks only when true

# --- Database --------------------------------------------------------------
# Async Postgres (asyncpg driver). Example sync-only fallback for tests is
# handled separately in tests/confest.py (aiosqlite).
DATABASE_URL=postgresql+asyncpg://synora:synora@localhost:55432/synora

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<generate-a-random-64-char-urlsafe-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Rate limiting ---------------------------------------------------------
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900           # 15 min
LOGIN_LOCKOUT_SECONDS=900

REFRESH_COOKIE_SECURE=true                        # set false for local http dev

# --- CORS ------------------------------------------------------------------
# Comma-separated origins. No wildcard in anything resembling production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Uploads ---------------------------------------------------------------
# Local disk in dev. In production point these at S3/MinIO; the /files static
# mount then becomes unused (see README "Object storage").
UPLOAD_DIR=uploads

# S3-compatible object storage (MinIO / AWS S3 / R2 / Spaces). Leave
# S3_ENDPOINT empty to keep local-disk uploads.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=synora-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=            # e.g. https://s3.example.com for public reads

# --- Email / password reset -------------------------------------------------
# PUBLIC_APP_URL is the base your users reach the app from (used to build the
# password-reset link; also the absolute URL in reset emails).
PUBLIC_APP_URL=http://localhost:3000
EMAIL_ENABLED=false                            # log-only fallback when false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@synora.example
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_MINUTES=45

# --- Payme (Uzbekistan payment gateway) ------------------------------------
# Sandbox (test.paycom.uz) credentials live in your Payme dashboard. The
# webhook Basic-auth password must be the TEST KEY while payme_is_test=true.
PAYME_CHECKOUT_BASE_URL=https://test.paycom.uz   # live: https://checkout.paycom.uz
PAYME_LOGIN=Paycom
PAYME_KEY=
PAYME_MERCHANT_ID=                              # cashier id used in the pay link path
PAYME_IS_TEST=true